# name: test/sql/compose.test
# description: Composed examples — two of the worker's objects in one query
# group: [sql]

require-env VGI_SYMBOLS_WORKER

require-env VGI_SYMBOLS_DIR

statement ok
LOAD vgi;

statement ok
ATTACH 'symbols' AS symbols (TYPE vgi, LOCATION '${VGI_SYMBOLS_WORKER}');

# source_kinds anti-joined to sources(): on a fresh worker both local kinds are
# still unregistered. This assertion relies on running before any other test
# file registers a source in a reused worker process (the HTTP leg shares one
# container across files); it does, as compose.test sorts first in test/sql.
query TT
SELECT k.kind, k.locator_arg FROM symbols.main.source_kinds AS k WHERE k.egress = false AND k.kind NOT IN (SELECT s.kind FROM symbols.main.sources() AS s) ORDER BY k.kind;
----
dir	path
glob	path

statement ok
CALL symbols.add_source('dir', path => '${VGI_SYMBOLS_DIR}');

# Once a dir source is registered, only glob is left.
query TT
SELECT k.kind, k.locator_arg FROM symbols.main.source_kinds AS k WHERE k.egress = false AND k.kind NOT IN (SELECT s.kind FROM symbols.main.sources() AS s) ORDER BY k.kind;
----
glob	path

# module_info compared with module_info on debug_id (the EX_MATCH_DEBUG_FILE
# shape, fixture paths swapped in): a file matches itself ...
query TTTTTT
SELECT coalesce(b.debug_id = d.debug_id, false) AS matches, b.debug_id AS binary_debug_id, d.debug_id AS debug_file_debug_id, d.format, d.arch, d.has_line_table FROM (SELECT 1) AS one LEFT JOIN symbols.main.module_info('${VGI_SYMBOLS_DIR}/macho_inline.dwarf') AS b ON true LEFT JOIN symbols.main.module_info('${VGI_SYMBOLS_DIR}/macho_inline.dwarf') AS d ON true;
----
true	76ff8518da153e64a8403892fcbf11250	76ff8518da153e64a8403892fcbf11250	MachO	aarch64	true

# ... two different builds do not ...
query T
SELECT coalesce(b.debug_id = d.debug_id, false) AS matches FROM (SELECT 1) AS one LEFT JOIN symbols.main.module_info('${VGI_SYMBOLS_DIR}/macho_inline.dwarf') AS b ON true LEFT JOIN symbols.main.module_info('${VGI_SYMBOLS_DIR}/macho_compute.dwarf') AS d ON true;
----
false

# ... and missing paths still give one row (the verdict is false, columns NULL).
query TTTTTT
SELECT coalesce(b.debug_id = d.debug_id, false) AS matches, b.debug_id AS binary_debug_id, d.debug_id AS debug_file_debug_id, d.format, d.arch, d.has_line_table FROM (SELECT 1) AS one LEFT JOIN symbols.main.module_info('/srv/bin/myapp') AS b ON true LEFT JOIN symbols.main.module_info('/srv/debug/myapp.debug') AS d ON true;
----
false	NULL	NULL	NULL	NULL	NULL
